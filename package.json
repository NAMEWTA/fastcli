{
  "name": "@namewta/fastcli",
  "version": "3.2.10",
  "description": "AI CLI launcher and npm manager for Claude, Codex, Gemini, Grok, OpenCode and Pi",
  "type": "module",
  "author": {
    "name": "namewta",
    "url": "https://github.com/namewta"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/namewta/fastcli.git"
  },
  "bugs": {
    "url": "https://github.com/namewta/fastcli/issues"
  },
  "homepage": "https://github.com/namewta/fastcli#readme",
  "bin": {
    "fastcli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "link": "pnpm build && pnpm link -g",
    "unlink": "pnpm unlink -g",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ai",
    "cli",
    "claude",
    "codex",
    "gemini",
    "yolo",
    "launcher"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "cross-spawn": "^7.0.6",
    "picocolors": "1.1.1",
    "read-cmd-shim": "^5.0.0",
    "semver": "^7.7.0",
    "string-width": "7.2.0",
    "wrap-ansi": "9.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
